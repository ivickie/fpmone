# FPM Global - Production & Deployment Environment Variables
# Configure these in your Vercel Project Settings (Environment Variables)

NODE_ENV=production
PORT=5000

# PostgreSQL / Supabase Database Connection
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres"

# JWT Authentication (Required in production)
JWT_SECRET="your_secure_jwt_secret_key_here"

# Supabase Storage & Services
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Security & CORS (Optional: Comma-separated domains; fpmglobal.online & *.vercel.app allowed by default)
ALLOWED_ORIGINS="https://fpmglobal.online,https://www.fpmglobal.online"
CRON_SECRET="your_cron_secret_here"

# Church Business Logic Defaults
AUTO_CLOCK_OUT_HOURS=4.0
DEFAULT_GRACE_PERIOD_MINUTES=15
