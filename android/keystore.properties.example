# FPM Global - Release Keystore Configuration Template
# DO NOT COMMIT THE ACTUAL 'keystore.properties' TO VERSION CONTROL.
# Copy this file to 'keystore.properties' and fill in your secure release credentials,
# OR set the following environment variables in your CI/CD pipeline:
#   FPM_KEYSTORE_PATH
#   FPM_KEYSTORE_PASSWORD
#   FPM_KEY_ALIAS
#   FPM_KEY_PASSWORD

storeFile=release.keystore
storePassword=YOUR_SECURE_KEYSTORE_PASSWORD
keyAlias=fpmglobal
keyPassword=YOUR_SECURE_KEY_PASSWORD
